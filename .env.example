NODE_ENV=development
PORT=3333
APP_KEY=development-only-antirecurso-api-app-key
HOST=0.0.0.0
LOG_LEVEL=info
SESSION_DRIVER=cookie

DB_URL=postgres://user:password@host:5432/database
DB_SCHEMA=antirecurso
DB_MIGRATION_URL=postgres://migrator:password@host:5432/database
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

AUTH_ISSUER_URL=https://auth.nei-isep.org
AUTH_PROJECT_ID=replace-with-antirecurso-project-id
AUTH_GLOBAL_PROJECT_ID=replace-with-nei-global-project-id
AUTH_ALLOWED_AUDIENCES=replace-with-antirecurso-project-id
AUTH_ROLE_CLAIM=urn:zitadel:iam:org:project:replace-with-nei-global-project-id:roles
AUTH_DEBUG=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://antirecurso.nei-isep.org

S3_ENDPOINT=http://minio-gbheij1ljds8nrhfgdf9teeo:9000
S3_ACCESS_KEY=replace-with-bucket-scoped-access-key
S3_SECRET_KEY=replace-with-bucket-scoped-secret-key
S3_BUCKET=antirecurso-dev-notes
SHARED_DATA_NETWORK=gbheij1ljds8nrhfgdf9teeo
LIMITER_STORE=database
RUN_MIGRATIONS=false
