NODE_ENV=production
PORT=3333
APP_KEY=replace-with-a-random-app-key
HOST=0.0.0.0
LOG_LEVEL=info
SESSION_DRIVER=cookie

DB_URL=postgres://user:password@host:5432/database
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false

AUTH_ISSUER_URL=https://zitadel.example.com
AUTH_ALLOWED_AUDIENCES=replace-with-zitadel-audience
# Optional override. The default supports the shared-project ZITADEL role claim.
AUTH_ROLE_CLAIM=urn:zitadel:iam:org:project:roles
CORS_ALLOWED_ORIGINS=https://antirecurso.nei-isep.org

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=replace-with-your-private-storage-bucket
