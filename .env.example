NODE_ENV=development
PORT=3333
APP_KEY=replace-with-a-random-app-key
HOST=0.0.0.0
LOG_LEVEL=info
SESSION_DRIVER=cookie

DB_URL=postgres://user:password@host:5432/database
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false

AUTH_ISSUER_URL=https://auth.nei-isep.org
AUTH_ALLOWED_AUDIENCES=replace-with-antirecurso-project-id
# Global NEI admin Project role claim. Replace the project id with the shared admin Project ID.
AUTH_ROLE_CLAIM=urn:zitadel:iam:org:project:replace-with-nei-global-project-id:roles
AUTH_DEBUG=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://antirecurso.nei-isep.org

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=notes
LIMITER_STORE=database
RUN_MIGRATIONS=false
